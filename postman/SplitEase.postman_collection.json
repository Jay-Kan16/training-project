{
  "info": {
    "name": "SplitEase - MERN Expense Splitter",
    "description": "Full API collection for the SplitEase backend. Run 'Login' or 'Signup' first — the token and ids are captured automatically into the environment and reused by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:5000/api" }],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Sharma\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "if (data.token) pm.environment.set('token', data.token);",
                  "if (data.user && data.user.id) pm.environment.set('userId', data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "if (data.token) pm.environment.set('token', data.token);",
                  "if (data.user && data.user.id) pm.environment.set('userId', data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user (Me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users (admin only)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Alice S.\"\n}" }
          }
        },
        {
          "name": "Delete user (admin only)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "Create group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/groups", "host": ["{{baseUrl}}"], "path": ["groups"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Goa Trip\",\n  \"members\": []\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "if (data.group && data.group._id) pm.environment.set('groupId', data.group._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List my groups",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/groups", "host": ["{{baseUrl}}"], "path": ["groups"] }
          }
        },
        {
          "name": "Get group by id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/groups/{{groupId}}", "host": ["{{baseUrl}}"], "path": ["groups", "{{groupId}}"] }
          }
        },
        {
          "name": "Update group",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/groups/{{groupId}}", "host": ["{{baseUrl}}"], "path": ["groups", "{{groupId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Goa Trip 2026\"\n}" }
          }
        },
        {
          "name": "Get group balances & settlements",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/groups/{{groupId}}/balances",
              "host": ["{{baseUrl}}"],
              "path": ["groups", "{{groupId}}", "balances"]
            }
          }
        },
        {
          "name": "Delete group",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/groups/{{groupId}}", "host": ["{{baseUrl}}"], "path": ["groups", "{{groupId}}"] }
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Create expense (equal split)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/expenses", "host": ["{{baseUrl}}"], "path": ["expenses"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Dinner\",\n  \"amount\": 1200,\n  \"payer\": \"{{userId}}\",\n  \"participants\": [\"{{userId}}\"],\n  \"group\": \"{{groupId}}\",\n  \"splitType\": \"equal\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "if (data.expense && data.expense._id) pm.environment.set('expenseId', data.expense._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create expense (percentage split)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/expenses", "host": ["{{baseUrl}}"], "path": ["expenses"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Cab fare\",\n  \"amount\": 500,\n  \"payer\": \"{{userId}}\",\n  \"participants\": [\"{{userId}}\"],\n  \"group\": \"{{groupId}}\",\n  \"splitType\": \"percentage\",\n  \"rawShares\": [ { \"user\": \"{{userId}}\", \"percentage\": 100 } ]\n}"
            }
          }
        },
        {
          "name": "List expenses (filter by group/payer/date)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/expenses?group={{groupId}}",
              "host": ["{{baseUrl}}"],
              "path": ["expenses"],
              "query": [
                { "key": "group", "value": "{{groupId}}" },
                { "key": "payer", "value": "", "disabled": true },
                { "key": "startDate", "value": "", "disabled": true },
                { "key": "endDate", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get expense by id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/expenses/{{expenseId}}", "host": ["{{baseUrl}}"], "path": ["expenses", "{{expenseId}}"] }
          }
        },
        {
          "name": "Update expense",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/expenses/{{expenseId}}", "host": ["{{baseUrl}}"], "path": ["expenses", "{{expenseId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Dinner (updated)\",\n  \"amount\": 1350\n}" }
          }
        },
        {
          "name": "Delete expense",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/expenses/{{expenseId}}", "host": ["{{baseUrl}}"], "path": ["expenses", "{{expenseId}}"] }
          }
        }
      ]
    },
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
        "auth": { "type": "noauth" }
      }
    }
  ]
}
